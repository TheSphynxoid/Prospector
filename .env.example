# Where SQLite, backups and the embedding model cache live (inside the container)
DATA_DIR=/data
# Your profile (skills, projects, filters) — copy profile.example.yaml
PROFILE_PATH=/data/profile.yaml
DASHBOARD_URL=https://prospector.thesphynx.net

# OpenCode Go (OpenAI-compatible)
LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
LLM_MODEL=glm-5.3-flash
LLM_FALLBACK_MODEL=qwen3.8-flash
LLM_API_KEY=
LLM_DAILY_CAP=20
STAGE2_THRESHOLD=0.55

# Telegram digest (bot from @BotFather; chat id of your chat with the bot)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# mail-bridge Worker (workers.dev URL) and the shared HMAC secret
BRIDGE_URL=
BRIDGE_SECRET=

# Cloudflare Access (team domain e.g. yourteam.cloudflareaccess.com, application AUD tag)
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

# Optional sources
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
GITHUB_TOKEN=
# JSON list; omit to enable all
# ENABLED_SOURCES=["remotive","remoteok","himalayas","arbeitnow","adzuna","hn","github_bounties","freelancer","keejob","alerts"]
EMBED_MODEL=intfloat/multilingual-e5-base

# Tailscale IP of the server (docker-compose binds the dashboard to it)
TAILSCALE_IP=
